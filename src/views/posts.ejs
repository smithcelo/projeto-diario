<%- include('includes/head.ejs'); %>

  <%- include('includes/nav') %>

    <div class="container">
      <div class="row">

        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">
          <h1 class=" text-center">Blog do Marcelo</h1>
          <p class="lead text-center">Seja bem-vindo ao blog</p>

          <!-- includes msgs -->

          <% if (posts && posts.length> 0) { %>
            <% posts.forEach(post=> { %>
              <a href="/posts/<%= post._id %>"><%= post.assunto %></a> — criado em: <%= post.criadoEm ? new Date(post.criadoEm).toLocaleDateString('pt-BR') : 'N/D' %> — atualizado em: <%= post.atualizadoEm ? new Date(post.atualizadoEm).toLocaleDateString('pt-BR') : 'N/D' %> <br>
              <% }) %>
                <% } else { %>
                  <p class="text-center">Nenhum post encontrado.</p>
                  <% } %>




        </div>

        <div class="col-lg-2"></div>

      </div>

    </div>


    <%- include('includes/footer.ejs'); %>