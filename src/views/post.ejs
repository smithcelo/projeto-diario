<%- include('includes/head.ejs'); %>

  <%- include('includes/nav') %>

    <div class="container">
      <div class="row">

        <div class="col-lg-2"></div>

        <div class="col-lg-8 my-3">


          <h1 class="text-center" id="assunto">
            <%= post.assunto %>
          </h1>
          <p class="lead text-center" id="texto">
            <%= post.texto %>
          </p>


          <div class="d-flex justify-content-center my-3">
            <button class="btn btn-danger mx-2" onclick="deletarPost('<%= post._id %>')">Apagar</button>
            <a href="/posts/edit/<%= post._id %>" class="btn btn-warning mx-2">Editar</a>
          </div>
        </div>


      </div>

    </div>


    <%- include('includes/footer.ejs'); %>